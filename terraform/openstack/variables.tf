variable "cloud_name" {
  description = "Entry in /etc/kolla/clouds.yaml generated by kolla-ansible post-deploy."
  type        = string
  default     = "admin"
}

variable "enable_resources" {
  description = "Safety switch for creating OpenStack networks, volumes and instances."
  type        = bool
  default     = false
}

variable "ssh_public_key" {
  description = "SSH public key installed in Kubernetes nodes."
  type        = string
  validation {
    condition     = can(regex("^ssh-(ed25519|rsa) [A-Za-z0-9+/=]+(?: .*)?$", trimspace(var.ssh_public_key)))
    error_message = "Provide one complete OpenSSH public key."
  }
}

variable "image_name" {
  type    = string
  default = "ubuntu-24.04"
}

variable "external_cidr" {
  type    = string
  default = "198.51.100.0/24"
}

variable "external_gateway" {
  type    = string
  default = "198.51.100.1"
}

variable "external_dns" {
  type    = list(string)
  default = ["192.0.2.1"]
}

variable "floating_ip_pool" {
  type = object({
    start = string
    end   = string
  })
  default = {
    start = "198.51.100.50"
    end   = "198.51.100.99"
  }
}

variable "tenant_cidr" {
  type    = string
  default = "203.0.113.0/24"
}

variable "tenant_gateway" {
  type    = string
  default = "203.0.113.1"
}

variable "kubernetes_api_host_number" {
  description = "Host number inside tenant_cidr excluded from Neutron allocation and reserved for kube-vip."
  type        = number
  default     = 10

  validation {
    condition = (
      var.kubernetes_api_host_number >= 3 &&
      can(cidrhost(var.tenant_cidr, var.kubernetes_api_host_number + 1)) &&
      cidrhost(var.tenant_cidr, var.kubernetes_api_host_number + 1) != cidrhost(var.tenant_cidr, -1)
    )
    error_message = "kubernetes_api_host_number must leave usable allocation ranges on both sides of the reserved kube-vip."
  }
}

variable "management_api_address" {
  description = "HA Kolla internal VIP used by its custom HAProxy listener for the management Kubernetes API."
  type        = string
  default     = "192.0.2.10"

  validation {
    condition = (
      can(regex("^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$", var.management_api_address)) &&
      can(cidrhost("${var.management_api_address}/32", 0))
    )
    error_message = "management_api_address must be an IPv4 address reachable from OpenStack controllers."
  }
}

variable "admin_cidr" {
  type    = string
  default = "192.0.2.0/24"
}

variable "kubernetes_nodes" {
  description = "Kubernetes nodes and Kubespray roles. Control-plane nodes use strict physical-host anti-affinity."
  type = map(object({
    fixed_ip        = string
    floating_ip     = string
    volume_size     = number
    roles           = set(string)
    inventory_order = number
  }))
  default = {
    k8s-01 = {
      fixed_ip        = "203.0.113.11"
      floating_ip     = "198.51.100.50"
      volume_size     = 120
      roles           = ["control_plane", "etcd", "worker"]
      inventory_order = 10
    }
    k8s-02 = {
      fixed_ip        = "203.0.113.12"
      floating_ip     = "198.51.100.51"
      volume_size     = 120
      roles           = ["control_plane", "etcd", "worker"]
      inventory_order = 20
    }
    k8s-03 = {
      fixed_ip        = "203.0.113.13"
      floating_ip     = "198.51.100.52"
      volume_size     = 120
      roles           = ["control_plane", "etcd", "worker"]
      inventory_order = 30
    }
  }

  validation {
    condition     = length(var.kubernetes_nodes) >= 3
    error_message = "The initial management Kubernetes cluster requires at least three nodes."
  }

  validation {
    condition = alltrue([
      for name, node in var.kubernetes_nodes :
      can(regex("^k8s-[a-z0-9-]+$", name)) &&
      length(node.roles) > 0 &&
      length(setsubtract(node.roles, ["control_plane", "etcd", "worker"])) == 0 &&
      node.volume_size >= 40
    ])
    error_message = "Node names, roles or volume sizes are invalid."
  }

  validation {
    condition = (
      length(distinct([for node in values(var.kubernetes_nodes) : node.fixed_ip])) == length(var.kubernetes_nodes) &&
      length(distinct([for node in values(var.kubernetes_nodes) : node.floating_ip])) == length(var.kubernetes_nodes) &&
      length(distinct([for node in values(var.kubernetes_nodes) : node.inventory_order])) == length(var.kubernetes_nodes)
    )
    error_message = "Fixed IPs, floating IPs and inventory_order values must be unique."
  }

  validation {
    condition = alltrue([
      for node in values(var.kubernetes_nodes) :
      node.fixed_ip != var.tenant_gateway &&
      node.fixed_ip != cidrhost(var.tenant_cidr, var.kubernetes_api_host_number)
    ])
    error_message = "Kubernetes node fixed IPs must not use the tenant gateway or reserved kube-vip."
  }

  validation {
    condition = alltrue([
      for node in values(var.kubernetes_nodes) :
      node.floating_ip != var.external_gateway &&
      node.floating_ip != cidrhost(var.external_cidr, 2)
    ])
    error_message = "Floating IPs must not use the provider gateway or the router's reserved external address."
  }

  validation {
    condition = (
      length([for node in values(var.kubernetes_nodes) : node if contains(node.roles, "control_plane")]) % 2 == 1 &&
      length([for node in values(var.kubernetes_nodes) : node if contains(node.roles, "etcd")]) % 2 == 1 &&
      length(setsubtract(
        toset([for name, node in var.kubernetes_nodes : name if contains(node.roles, "control_plane")]),
        toset([for name, node in var.kubernetes_nodes : name if contains(node.roles, "etcd")])
      )) == 0 &&
      length(setsubtract(
        toset([for name, node in var.kubernetes_nodes : name if contains(node.roles, "etcd")]),
        toset([for name, node in var.kubernetes_nodes : name if contains(node.roles, "control_plane")])
      )) == 0 &&
      length([for node in values(var.kubernetes_nodes) : node if contains(node.roles, "worker")]) >= 1
    )
    error_message = "Control-plane and etcd memberships must match, their count must be odd, and at least one worker is required."
  }
}
